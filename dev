#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: dev <fe|be>

  fe, frontend  Run npm run frontend:dev
  be, backend   Run npm run backend:dev
EOF
}

target="${1:-}"

cd "$repo_root"

case "$target" in
  fe|frontend)
    exec npm run frontend:dev
    ;;
  be|backend)
    exec npm run backend:dev
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "Unknown target: $target" >&2
    usage >&2
    exit 1
    ;;
esac
