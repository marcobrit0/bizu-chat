# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments; on Vercel, AI Gateway uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Used by Vercel to authenticate the blob-deletion retry cron
CRON_SECRET=****

# Pooled Neon Postgres runtime URL (or another pooled Postgres URL)
# https://vercel.com/marketplace/neon
POSTGRES_URL=****

# Redis for resumable chat streams (optional locally)
# https://vercel.com/docs/redis
REDIS_URL=****
